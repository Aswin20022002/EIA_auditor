# At least one of these two is required. Both is recommended: if the
# primary provider hits a rate limit or a server error mid-analysis, the
# app automatically retries that one call on the other provider.

# Gemini is used first by default. Free key: https://aistudio.google.com/apikey
# Note: Google has tightened Gemini's free daily request quota more than
# once (most recently around Dec 2025). If you're relying on this for a
# live demo, test it beforehand, and keep GROQ_API_KEY set as a fallback.
GEMINI_API_KEY=your_gemini_api_key_here

# Free key: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Optional. "gemini" or "groq". Overrides which provider is tried first;
# otherwise Gemini is preferred whenever GEMINI_API_KEY is set.
# LLM_PROVIDER=gemini

# Optional overrides, only needed if you want a specific model version.
# GEMINI_MODEL=gemini-2.5-flash
# GROQ_MODEL=openai/gpt-oss-120b
